<header class="site-header">
  <div class="header-inner container">
    <a class="site-name" href="{{ '/' | relative_url }}">Onur Cankur</a>
    <div class="navigation-controls">
      <button class="menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span>Menu</span>
      </button>
      <nav id="site-navigation" class="site-navigation" aria-label="Main navigation">
        {% for item in site.data.navigation %}
          {% assign active = false %}
          {% if page.url == item.url %}{% assign active = true %}{% endif %}
          {% if page.nav_section == item.url %}{% assign active = true %}{% endif %}
          {% if item.url == '/software/' and page.collection == 'projects' %}{% assign active = true %}{% endif %}
          <a
            href="{{ item.url | relative_url }}"
            {% if active %}
              aria-current="page"
            {% endif %}
          >
            {{- item.title -}}
          </a>
        {% endfor %}
      </nav>
      <button id="light-toggle" class="theme-toggle" type="button" title="Change color theme" aria-label="Change color theme">
        <svg class="theme-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="8" />
          <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none" />
        </svg>
      </button>
    </div>
  </div>
</header>
